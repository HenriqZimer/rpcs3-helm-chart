Hash: SHA512

annotations:
  artifacthub.io/changes: |
    - kind: changed
      description: README now shows the emulator's logo at the top (linuxserver.io's own image, same one used for the chart icon)
  artifacthub.io/changesHistory: |
    - version: 1.0.3
      changes:
        - kind: added
          description: Chart releases are now signed (helm package --sign) - see artifacthub.io/signKey for the public key location and fingerprint, powers the "Signed" badge on ArtifactHub
    - version: 1.0.2
      changes:
        - kind: added
          description: values.schema.json - validates values.yaml against a JSON Schema, and is what powers the "Values schema" feature/badge on ArtifactHub (previously absent)
    - version: 1.0.1
      changes:
        - kind: added
          description: icon, previously missing entirely - pointed at linuxserver.io's own logo image for this app, which is why no image was ever showing on ArtifactHub
    - version: 1.0.0
      changes:
        - kind: added
          description: Initial release of the RPCS3 Helm chart
        - kind: added
          description: GPU passthrough for both Intel/AMD (VA-API via /dev/dri) and NVIDIA (via the NVIDIA Kubernetes device plugin, gpu.vendor=nvidia)
        - kind: added
          description: seccompUnconfined and a 2Gi default shmSize, both carried over from this chart's sibling pcsx2-helm-chart after PCSX2's JIT recompiler was found to crash with SIGBUS under Docker/Kubernetes' default seccomp/shm limits - not independently confirmed on RPCS3, but the same base image/toolchain makes it a likely fix if you hit the same crash
        - kind: added
          description: streaming.enabled/streaming.brokerPort to expose the RomM emulator-streaming broker sidecar port. WARNING - the rpcs3-romm-integration mod has never been merged/released, only an unreleased ":dev" image tag exists
  artifacthub.io/license: MIT
  artifacthub.io/links: |
    - name: Helm Repository
      url: https://henriqzimer.github.io/rpcs3-helm-chart/
    - name: Chart Source
      url: https://github.com/HenriqZimer/rpcs3-helm-chart
    - name: Maintainer Website
      url: https://henriqzimer.com.br
    - name: GitHub Profile
      url: https://github.com/HenriqZimer
    - name: linuxserver.io RPCS3 Image
      url: https://docs.linuxserver.io/images/docker-rpcs3/
    - name: Documentation
      url: https://github.com/HenriqZimer/rpcs3-helm-chart/blob/main/chart/README.md
